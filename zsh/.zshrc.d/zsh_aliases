# vim:ft=sh
# ~/.zsh_aliases
#
# Some example alias instructions
# If these are enabled they will be used instead of any instructions
# they may mask.  For example, alias rm='rm -i' will mask the rm
# application.  To override the alias instruction use a \ before, ie
# \rm will call the real rm not the alias.
#
# File: misc
#
# Update source file
alias src='source ~/.zshrc'
# Clear terminal display
alias c='clear'
# Go Home
alias ~="cd ~"
alias ~dow="cd ~/Downloads"
alias ~doc="cd ~/Documents"
alias ~git="cd ~/git"

# Interactive operation
alias rm='rm -vi'
alias cp='cp -vi'
alias mv='mv -vi'
# Create parent directories and report what was made
alias mkdir='mkdir -pv'
#
# Default to human readable figures
alias df='df -hTP'
alias du='du -xk'

# Colorize common text tools
alias grep='grep --color=auto'
alias diff='diff --color=auto'

# Directory: list
#
# Classify files in colour show directories on top
alias ls='ls -atrhF --color=auto --group-directories-first'
# alias dir='ls --color=auto --format=vertical'
# alias vdir='ls --color=auto --format=long'
# Long list
alias ll='ls -l'
# All but . and ..
alias la='ls -A'
alias l='ls -CF'
alias lsg="ls | grep -i"
alias lsag="ls -a | grep -i"

# Directory: change
#
# Go back 1 directory level (for fast typers)
alias cd..='cd ../'
# Go back 1 directory level
alias ..='cd ../'
# Go back 2 directory levels
alias ...='cd ../../'
# Go back 3 directory levels
alias .3='cd ../../../'
# Go back 4 directory levels
alias .4='cd ../../../../'
# Go back 5 directory levels
alias .5='cd ../../../../../'
# Go back 6 directory levels
alias .6='cd ../../../../../../'

# Regular Expressions: GNU grep (PCRE via -P is built in; no extra packages)
# Site: http://www.rexegg.com/regex-quickstart.html#ref
alias grep='grep -P --color=auto'
# Strip comments from files
alias cgrep='grep -Pv "^\s*(#|;|$)" --color=auto'
# Extended regex in colour
alias egrep='grep -E --color=auto'
# Fixed strings in colour
alias fgrep='grep -F --color=auto'
# Delete all lines beginning only with a # from a file and also empty lines
alias rg_comments="grep -Pv '^(\s+)?(#|;)|^(\s+)?$'"
# Show some oracle database kernel tuning
alias rg_orasysctl="grep -P 'vm.(swappiness|dirty_(background_ratio|ratio|(expire|writeback)_centisecs))'"
# Show 3rd party kernel modules
alias rg_3rdkmodinfo="grep -P '(extra|weak)'"

# Regular Expressions: awk
# Delete all lines beginning with a # from a file
alias sumfile="awk 'BEGIN{s=0}{s=s+\$0}END{print s}'"
# Sum numerical matches from other outputs
alias rg_sumatch="awk '{SUM+=\$1}END{print SUM}'"
# Matches lines starting with sd and dm- and sort 10th columnt for
# number number greater than 10
alias rg_iosvctm="awk '/(dev|sd|dm-)/ { if ( \$10 > 10 ) print \$0 }'"
alias rg_ioawait="awk '/(dev|sd|dm-)/ { if ( \$9 > 10 ) print \$0 }'"

# Search
#
# Quickly search for something with find. 'fihe' stands for 'find here'
alias fihe="find . -iname"
#
# Find directories by name
alias fid='find . -type d -name'
# Find files by name
alias fif='find . -type f -name'

# Misc
alias vi='vim'
#alias less='less -r'                              # raw control characters
alias getmp3='yt-dlp -x --audio-format mp3'
# Inspect PATH one entry per line
alias path='echo -e ${PATH//:/\\n}'
# Public IP address
alias myip='curl -s ifconfig.me'

# Modern replacements — only active when the tool is installed
command -v duf  >/dev/null 2>&1 && alias df='duf'
command -v dust >/dev/null 2>&1 && alias du='dust'

# systemd / journal
alias jctl='journalctl -p 3 -xb'                    # this boot's errors
alias juser='journalctl --user -b'                  # user unit logs
alias boottime='systemd-analyze blame | head -15'   # slowest boot services

# toolbox
alias tb='toolbox enter'
alias tbc='toolbox create'

# Detect the running distribution (see man os-release)
OSCODENAME=""
if [ -r /etc/os-release ]; then
	. /etc/os-release
	OSCODENAME="${ID:-}"
fi
case "$OSTYPE" in
	cygwin*) OSCODENAME="cygwin" ;;
esac

case "${OSCODENAME}" in
    fedora)
		source ~/.zshrc.d/zsh_aliases.fedora
	;;
    debian|ubuntu|pop)
		source ~/.zshrc.d/zsh_aliases.ubuntu
	;;
    *)
	;;
esac
