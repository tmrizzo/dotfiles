# ~/.bash_profile: executed by bash(1) for login shells.

# Source the users bashrc if it exists (PATH, LM Studio, etc. come from there)
if [ -f "${HOME}/.bashrc" ] ; then
  source "${HOME}/.bashrc"
fi
