# ~/.bash_functions
# Some example functions:
#

# AICT shell functions (auto-installed by aict.sh; kept here to avoid duplication)
unalias aict 2>/dev/null
unalias aimt 2>/dev/null
aict() {
	local script
	script="$(cat ~/.config/aict/script_path 2>/dev/null)" || {
		echo "Error: aict not configured. Run aict.sh first." >&2
		return 1
	}
	"$script" "$@"
}
aimt() { aict --image aimt "$@"; }

# Create a directory and "cd" to it
mkd () {
  mkdir -p "$1"
  cd "$1" || return 1
}

#
# a) function settitle
settitle ()
{
   echo -ne "\e]2;$@\a\e]1;$@\a";
}

now() {
	echo $(date "+%Y-%m-%d %H:%M:%S") - "$@" >> $HOME/.now
}

# Auto-ls after cd (pairs well with shopt -s autocd)
cd() { builtin cd "$@" && ls; }

# Universal extractor: ex file.tar.gz / file.zip / ...
ex() {
	if [ -f "$1" ]; then
		case "$1" in
			*.tar.bz2|*.tbz2) tar xjf "$1" ;;
			*.tar.gz|*.tgz)   tar xzf "$1" ;;
			*.tar.xz)         tar xJf "$1" ;;
			*.tar)            tar xf  "$1" ;;
			*.zip)            unzip   "$1" ;;
			*.rar)            unrar x "$1" ;;
			*.7z)             7z x    "$1" ;;
			*)                echo "'$1': unknown archive type" >&2 ;;
		esac
	else
		echo "'$1' is not a file" >&2
	fi
}

# Quick backup: bak file.txt -> file.txt.bak
bak() { cp -a "$1" "$1.bak"; }

# Timer: timer 25 (minutes) or timer 90s
timer() {
	local t=${1//[a-z]/}
	[[ $1 == *s ]] || t=$((t*60))
	sleep "$t" && notify-send "Timer" "⏰ ${1} elapsed"
}

16colors() {
    #Background
    for bg in {40..47} {100..107} 49; do
    # Foreground
        for fg in {30..37} {90..97} 39; do
            # Formatting
            for attr in 0 1 2 4 5 7 ; do
                # Print the result
                printf "\e[%d;%d;%dm ^[%d;%d;%dm \e[0m" $attr $bg $fg $attr $bg $fg
            done
            echo #Newline
        done
    done
}

256colors() {
    for fgbg in 38 48; do #Foreground/Background
        #for color in {0..255} ; do #Colors
        x=0
        echo -n " "
        for color in {16..201} ; do #Colors
            # Display the color
            printf "\e[%s;5;%sm%0.3d\e[0m" $fgbg $color $color
            #Display 18 colors per lines
            [ $(((x+1) % 18)) == 0 ] && echo
            [ $(((x+1) % 6)) == 0 ] && echo -n " "
            ((x++))
        done
        echo #New line
   done
}
