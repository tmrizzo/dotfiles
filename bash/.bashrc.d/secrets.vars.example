# vim:ft=sh
# Example of ~/.bashrc.d/secrets.vars — local secrets and machine-specific
# environment. This file is gitignored (*.vars); copy to secrets.vars,
# fill in your values and keep permissions at 600:
#
#   $ cp ~/.bashrc.d/secrets.vars.example ~/.bashrc.d/secrets.vars
#   $ chmod 600 ~/.bashrc.d/secrets.vars
#
# Keep the real file organized in commented sections (like below) so
# unrelated settings don't interleave over time.

# --- API keys / tokens (rotate any value that was ever committed or exposed) ---
#export EXAMPLE_API_KEY=""

# --- tool-specific environment ---
# Reference another var instead of duplicating a key:
#export EXAMPLE_API_KEY_2="$EXAMPLE_API_KEY"

# Scope environment overrides to a single tool instead of exporting them
# globally — global XDG_* redirects would affect every app in the shell:
#some_tool() {
#	XDG_CONFIG_HOME="$HOME/.config/some_tool-private" \
#	command some_tool "$@"
#}

# --- machine setup notes ---
# Homebrew setup (brew shellenv) lives in ~/.bashrc.d/bash_path — it is not
# a secret and belongs under version control there.

# --- optional per-machine environment drop-ins ---
#[ -f "${HOME}/.config/somewhere/env.sh" ] && . "${HOME}/.config/somewhere/env.sh"
