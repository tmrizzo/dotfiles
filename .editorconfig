# EditorConfig — https://editorconfig.org
# Note: vim needs the editorconfig-vim plugin to honor this; other
# editors and IDEs usually support it natively.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{md,markdown}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false
