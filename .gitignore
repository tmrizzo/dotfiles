/vim/.vim/backup/*
/vim/.vim/swap/*
/vim/.vim/undo/*
/vim/.vim/.netrwhist
/vim/.netrwhist
/gtk/.config/gtk-4.0/servers
/gtk/.config/gtk-4.0/bookmarks
weechat/*

# Local secrets / machine tokens (never commit)
/bash/.bashrc.d/*.vars
# Any file or directory starting with "secrets" anywhere in the repo,
# except the committed example templates
secrets*
!secrets*.example

# Proprietary fonts — never commit (public repo, no redistribution rights)
/fonts/.local/share/fonts/Microsoft/
/fonts/.local/share/fonts/Segoe-UI/
/fonts/.local/share/fonts/SF-Pro/
/fonts/.local/share/fonts/SF-Mono/
/fonts/.local/share/fonts/New-York/
/fonts/.local/share/fonts/Graphik*/

# Credentials and key material — never commit
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
**/.netrc
**/.npmrc
**/.pypirc
**/.aws/
**/.kube/
**/.docker/
**/.gnupg/
**/.ssh/

# Shell/editor history and state — can contain interactively typed secrets
**/.bash_history
**/.zsh_history
**/.python_history
**/.node_repl_history
**/.lesshst
**/.viminfo
**/.wget-hsts
*.swp

# Local-only files referenced by the tracked configs
/tmux/.tmux.private
/zsh/.zshrc.d/*.vars
**/.config/claude-code-vertex/env.sh


